# Production config template. Copy to `.env` in the project root.
#
# The file is read by `Config` (pydantic-settings) and is the single source of the
# installation's knobs. Every key below is one; nothing else is read, and an unknown
# key is ignored rather than refused — so a stale line fails silently. Defaults shown
# are the ones in `src/core/config.py`.
#
# **You do not have to write this file.** It does not exist until the first launch:
# the app creates it with defaults and writes itself the two secrets (MCP token and
# master key), chmod 600. Edit it afterwards on the «Сервер» page or by hand.
#
# Both roles read the same file. The worker runs the same `src/app.py` with
# `--worker --no-backend` and overrides its knobs from the command line (flag > env).

# ─── App: identity ────────────────────────────────────────────────────────────
# prod | dev | test — picks the runtime profile: runtime/<APP_ENV>/ holds the
# database (unless DB_PATH says otherwise), logs, cache and scratch dirs.
APP_ENV=prod
APP_LOG_LEVEL=INFO

# ─── Server: HTTP transport ───────────────────────────────────────────────────
# This is the web process → serve the HTTP zones. CLI: --backend / --no-backend.
SERVER_ENABLED=true
# 127.0.0.1 keeps the app off the network — put a reverse proxy in front of it and
# let that terminate TLS. 0.0.0.0 only when something else does the filtering.
SERVER_HOST=127.0.0.1
SERVER_PORT=13410
# Hot-reload is a development convenience — keep it false here.
SERVER_HOT_RELOAD=false
# uvicorn processes (HTTP scaling, NOT the background worker). >1 spreads across
# cores; migrations are applied by the update command, never by a starting process.
SERVER_PROCESSES=1
# Vite dev-server port — development only (CORS + proxy target). Empty in prod:
# the backend serves the built SPA from web/dist itself.
SERVER_VITE_PORT=
# DEBUG-only per-request delay (ms) on the internal zone; keep 0.
SERVER_DEBUG_DELAY_MS=0

# ─── MCP: modules mounted as MCP servers (zone /mcp) ──────────────────────────
# Allowed Host headers for the mounted servers (CSV) — a DNS-rebinding guard at the
# ASGI layer. Behind a proxy set your public host(s); empty disables the check.
MCP_ALLOWED_HOSTS=
# Static bearer token guarding /mcp/<code>. Empty = allow-all (local use only).
# Generated on first launch; the «MCP-серверы» page embeds it into the ready-made
# client config. Rotating it here invalidates every copied client entry.
MCP_TOKEN=

# MCP stdio shim (`--mcp-stdio <code>`) — the wake-on-demand path: the client spawns
# the shim over stdio, it lazily boots the backend and bridges calls to /mcp/<code>.
# The backend outlives the shim, so the next session attaches to the running one.
# Open the system browser on the home page once the backend is up.
MCP_STDIO_OPEN_BROWSER=true
# Start the scheduler alongside the backend the shim boots.
MCP_STDIO_START_WORKER=false
# Seconds to wait for backend readiness (/internal/health) after spawn.
MCP_STDIO_BOOT_TIMEOUT=30
# Which mounted server the shim bridges to. Empty = the only one mounted; with two
# or more the shim refuses to guess. The launch flag `--mcp-stdio <code>` beats this:
# one installation, one .env, but a client may keep an entry per server.
MCP_STDIO_CODE=
# Workspace bound to connections of this installation by default. Empty = the agent
# picks one per session (workspaces_list → workspace_use). The launch flag
# `--mcp-workspace <code>` beats this, for the same reason.
MCP_WORKSPACE=

# ─── Update: `src/app.py update` (./update.sh) ────────────────────────────────
# Branch this install is updated to: the command fast-forwards onto origin/<branch>
# and REFUSES when the checkout stands on another one — an update does not move the
# install to another line of code. The remote is deliberately not an ENV key: `.env`
# is written unescaped and behind no auth, and `--upload-pack=…` is code execution.
UPDATE_BRANCH=main

# ─── Secrets: master key for values encrypted in the DB ───────────────────────
# 32 bytes in base64url. Generated on first start and written here; a database copy
# taken without it cannot be decrypted. Empty is not a startup error — it means
# "encryption off". Keep it in this file rather than in a client config: a backend
# started by hand must see the same key as one started by the stdio shim.
#
# NOTE: nothing reads it at the moment. Its only consumer was the connectors module,
# retired on 2026-09-20; the key is still generated and waits for the next one.
SECRETS_KEY=

# ─── Database: provider ───────────────────────────────────────────────────────
# sqlite — the default: one file, no server, nothing to install.
# postgres — for scale; requires a 14+ server with the database and user created.
DB_PROVIDER=sqlite
# SQLite file, relative to the project root. Empty = runtime/<APP_ENV>/app.sqlite3.
DB_PATH=

# ─── Database: connection (postgres only) ─────────────────────────────────────
# All four are required when DB_PROVIDER=postgres — Config refuses to start without
# them. Leave them empty on sqlite.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Log every SQL statement. Noisy; for debugging only.
DB_ECHO=false

# ─── Database: TLS (postgres only) ────────────────────────────────────────────
# true on any network you do not control. DB_CERT is required then (verify-full).
DB_SSL=false
# Path to the CA certificate, from the project root.
DB_CERT=
# Client certificate for mutual TLS — set as a pair, or leave both empty.
DB_CLIENT_CERT=
DB_CLIENT_KEY=

# ─── Database: pool ───────────────────────────────────────────────────────────
# Connection establishment timeout, sec.
DB_CONNECT_TIMEOUT=10
# Persistent connections in the pool.
DB_POOL_SIZE=10
# Extra connections for bursts (closed afterwards).
DB_MAX_OVERFLOW=5
# Recycle a connection every N sec — keep it below any NAT/proxy idle timeout.
DB_POOL_RECYCLE=1800
# How long to wait for a pooled connection, sec.
DB_POOL_TIMEOUT=30

# ─── Database: performance ────────────────────────────────────────────────────
# Limit per single query, sec; 0 = no limit (safe for heavy DDL).
DB_COMMAND_TIMEOUT=0
# Liveness check before checkout (+1 round-trip, guards against dropped connections).
DB_POOL_PRE_PING=true
# Keepalive toward the server, idle sec; 0 = server default.
DB_TCP_KEEPALIVES_IDLE=60

# ─── Database: migrations ─────────────────────────────────────────────────────
# Nothing to set here. Startup never migrates a database that already has a schema
# (an empty one bootstraps itself), so the update command owns the whole chain. A
# database behind the code serves a stub page naming the pending revisions.

# ─── Worker: scheduler + background tasks ─────────────────────────────────────
# Server role → false when the worker runs as its own process (`--worker
# --no-backend`). Set true to run both halves in one process.
WORKER_ENABLED=false
# Scope: CSV of module names whose tasks this worker runs; empty = all.
# CLI: --worker-module
WORKER_MODULES=
# How often the registry is checked for due tasks, sec. CLI: --worker-tick-seconds
WORKER_TICK_SECONDS=5
# Max tasks running at once; keep <= DB_POOL_SIZE + DB_MAX_OVERFLOW.
# CLI: --worker-max-concurrent
WORKER_MAX_CONCURRENT_RUNS=10
