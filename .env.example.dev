# Development config template. Copy to `.env` in the project root.
#
# Differs from `.env.example.prod` in four knobs and nothing else — the file format,
# the keys and their meaning are the same, and the comments there are the fuller ones.
# Here: the dev profile, hot reload, a Vite port, and the `dev` update branch.
#
# **You do not have to write this file.** It does not exist until the first launch:
# the app creates it with defaults and writes itself the two secrets (MCP token and
# master key), chmod 600. Run the app from the project root: `./run.sh dev`.

# ─── App: identity ────────────────────────────────────────────────────────────
# Picks the runtime profile: runtime/dev/ holds the database (unless DB_PATH says
# otherwise), logs, cache and scratch dirs — kept apart from a prod install's.
APP_ENV=dev
APP_LOG_LEVEL=INFO

# ─── Server: HTTP transport ───────────────────────────────────────────────────
SERVER_ENABLED=true
SERVER_HOST=127.0.0.1
SERVER_PORT=13410
# Restart the backend on src/ changes (uvicorn --reload + file watch). Development
# only, and incompatible with SERVER_PROCESSES > 1.
# CLI: --hot-reload / --no-hot-reload, and the flag beats this value.
SERVER_HOT_RELOAD=true
SERVER_PROCESSES=1
# Vite dev server. With it set, the backend allows that origin (CORS) and Vite
# proxies /internal and /api back to SERVER_PORT.
# Mind the third port: `vite preview` silently takes SERVER_VITE_PORT + 1.
SERVER_VITE_PORT=13411
# Per-request delay (ms) on the internal zone — for looking at loading states.
SERVER_DEBUG_DELAY_MS=0

# ─── MCP: modules mounted as MCP servers (zone /mcp) ──────────────────────────
# Empty locally: no Host check (localhost only).
MCP_ALLOWED_HOSTS=
# Empty = allow-all. Generated on first launch; the «MCP-серверы» page embeds it
# into the ready-made client config.
MCP_TOKEN=

# MCP stdio shim (`--mcp-stdio <code>`): the client spawns it, it boots the backend
# and bridges calls to /mcp/<code>. The backend outlives the session.
MCP_STDIO_OPEN_BROWSER=true
MCP_STDIO_START_WORKER=false
MCP_STDIO_BOOT_TIMEOUT=30
# Empty = the only server mounted; with two or more the shim refuses to guess.
# The launch flag `--mcp-stdio <code>` beats this.
MCP_STDIO_CODE=
# Workspace bound to this installation's connections by default. Empty = the agent
# picks one per session. The launch flag `--mcp-workspace <code>` beats this.
MCP_WORKSPACE=

# ─── Update: `src/app.py update` (./update.sh) ────────────────────────────────
UPDATE_BRANCH=dev

# ─── Secrets: master key for values encrypted in the DB ───────────────────────
# Generated on first start. dev and prod installs hold different keys — a database
# copied between them without its key cannot be decrypted.
# NOTE: nothing reads it at the moment (see `.env.example.prod`).
SECRETS_KEY=

# ─── Database: provider ───────────────────────────────────────────────────────
# sqlite — one file, no server. Tests do not use this database at all: they build
# their own in-memory SQLite (see tests/README.md).
DB_PROVIDER=sqlite
# Empty = runtime/dev/app.sqlite3.
DB_PATH=

# ─── Database: connection (postgres only) ─────────────────────────────────────
# Required as a set when DB_PROVIDER=postgres; leave empty on sqlite. Heavy
# migration tests take their DSN from TEST_PG_DSN instead, not from these.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ECHO=false

# ─── Database: TLS (postgres only) ────────────────────────────────────────────
DB_SSL=false
DB_CERT=
DB_CLIENT_CERT=
DB_CLIENT_KEY=

# ─── Database: pool ───────────────────────────────────────────────────────────
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ─── Database: performance ────────────────────────────────────────────────────
DB_COMMAND_TIMEOUT=0
DB_POOL_PRE_PING=true
DB_TCP_KEEPALIVES_IDLE=60

# ─── Worker: scheduler + background tasks ─────────────────────────────────────
# `./run.sh dev` starts both halves in one process anyway (--backend --worker), so
# this value only matters for a bare `uv run python src/app.py`.
WORKER_ENABLED=false
WORKER_MODULES=
WORKER_TICK_SECONDS=5
WORKER_MAX_CONCURRENT_RUNS=10
